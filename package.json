{
  "name": "telespam",
  "version": "0.6.0",
  "description": "self-host anti-spam solution for telegram",
  "keywords": [
    "anti-spam",
    "self-host",
    "telegram"
  ],
  "homepage": "https://github.com/guoyunhe/telespam#readme",
  "bugs": {
    "url": "https://github.com/guoyunhe/telespam/issues"
  },
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me",
    "url": "https://guoyunhe.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoyunhe/telespam.git"
  },
  "bin": {
    "telespam": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./bin": "./dist/bin.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "start": "tsx src/bin.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guoyunhe/retry": "^1.1.0",
    "commander": "^15.0.0",
    "fast-shuffle": "^6.2.1",
    "grammy": "^1.37.0",
    "i18next": "^26.4.0"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "tsdown": "^0.22.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue,json,jsonc,css,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
}
